# Auto-trading (docs/AUTO_TRADING_SPEC.md). Copy to .env; never commit .env.
# IB account the engine is allowed to trade (paper accounts start with DU).
TRADING_ACCOUNT_ID=

# IB Gateway connection. Paper: 4002 (Gateway) / 7497 (TWS). Live: 4001 / 7496.
IB_HOST=127.0.0.1
IB_PORT=4002
# 1 = trading engine, 2 = web UI, 3+ = scripts (each connection needs its own ID)
IB_CLIENT_ID=1

# Engine journal path (default data/trading/journal.db) and log level.
# TRADING_JOURNAL=data/trading/journal.db
# LOG_LEVEL=INFO

# Alerts (T20). Email via SMTP with STARTTLS, and/or Telegram push.
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=you@example.com
# ALERT_SMTP_PASSWORD=app-password
# ALERT_EMAIL_FROM=you@example.com
# ALERT_EMAIL_TO=you@example.com
# ALERT_TELEGRAM_TOKEN=123456:ABC...      (from @BotFather)
# ALERT_TELEGRAM_CHAT_ID=123456789
