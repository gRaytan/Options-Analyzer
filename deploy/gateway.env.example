# IB Gateway login for the gnzsnz/ib-gateway image. Copy to deploy/gateway.env.
# deploy/gateway.env is gitignored: NEVER commit it.
TWS_USERID=your_paper_username
TWS_PASSWORD=your_paper_password
# paper | live
TRADING_MODE=paper
# Password for the VNC screen on 127.0.0.1:5900
VNC_SERVER_PASSWORD=change_me
# Daily restart time (IBC). Pick a quiet time.
AUTO_RESTART_TIME=11:45 PM
# What to do when the weekly 2FA approval times out: restart and ask again.
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
